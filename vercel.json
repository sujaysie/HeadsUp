{
  "version": 2,
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/favicon.ico",
      "dest": "/icon.svg"
    },
    {
      "src": "/favicon.png",
      "dest": "/icon.svg"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
